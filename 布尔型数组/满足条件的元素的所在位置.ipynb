   "metadata": {},
   "outputs": [],
   "source": [
    "#模拟英语六级成绩的随机数组，取10000个样本\n",
    "arr=np.random.normal(500,70,1000)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "99fc23ce",
   "metadata": {},
   "outputs": [],
   "source": [
    "#找出六级成绩超过650的元素所在位置\n",
    "print(np.where(arr>650))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a7a7157b",
   "metadata": {},
   "outputs": [],
   "source": [
    "#找出六级成绩最高分的元素所在位置\n",
    "print(np.where(arr==np.max(arr))[0])"
   ]
  }
